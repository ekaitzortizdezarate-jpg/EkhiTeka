                <span>{totalPrice.toFixed(2)} €</span>
              </div>
              <div className="flex justify-between text-base sm:text-lg font-black text-stone-900 dark:text-stone-100">
                <span>{t.cart_total}</span>
                <span>{totalPrice.toFixed(2)} €</span>
              </div>
            </div>

            <button
              type="submit"
              disabled={loading}
