      <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3 sm:gap-3.5">
        {curatedCards.map((card) => {
          const isSelected = selectedCategory === card.id;
          return (
            <button
              key={card.id}
